<UserControl x:Class="Codeer.LowCode.Bindings.ApexCharts.Designer.Controls.AggregateChartSeriesPropertyControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:Codeer.LowCode.Bindings.ApexCharts.Designer.ViewModels"
             xmlns:converters="clr-namespace:Codeer.LowCode.Bindings.ApexCharts.Designer.Converters"
             xmlns:properties="clr-namespace:Codeer.LowCode.Bindings.ApexCharts.Designer.Properties"
             mc:Ignorable="d" d:DesignHeight="300" d:DesignWidth="560"
             d:DataContext="{d:DesignInstance viewModels:AggregateChartSeriesViewModel}">
  <UserControl.Resources>
    <converters:SeriesTypeToStringConverter x:Key="SeriesTypeToStringConverter" />
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="auto" />
    </Grid.RowDefinitions>

    <!-- 見出し (列幅は行のテンプレートと同じ) -->
    <Grid Margin="0,0,0,3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="24" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{x:Static properties:Resources.Header_Function}" />
      <TextBlock Grid.Column="1" Text="{x:Static properties:Resources.Header_Field}" />
      <TextBlock Grid.Column="2" Text="{x:Static properties:Resources.Header_Title}" />
      <TextBlock Grid.Column="3" Text="{x:Static properties:Resources.Header_Type}" />
      <TextBlock Grid.Column="4" Text="{x:Static properties:Resources.Header_Color}" />
    </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <ItemsControl ItemsSource="{Binding Series}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="24" />
                </Grid.ColumnDefinitions>
                <ComboBox Margin="0,0,3,0" SelectedItem="{Binding Function,Mode=TwoWay}" ItemsSource="{Binding FunctionCandidates}" />
                <ComboBox Grid.Column="1" Margin="0,0,3,0" IsEditable="True" Text="{Binding Name,Mode=TwoWay}"
                          IsEnabled="{Binding IsNameEditable}" ItemsSource="{Binding NameCandidates}" />
                <TextBox Grid.Column="2" Margin="0,0,3,0" Text="{Binding Title,Mode=TwoWay}" />
                <ComboBox Grid.Column="3" Margin="0,0,3,0" IsEnabled="{Binding IsTypeEditable}"
                          SelectedItem="{Binding Type,Mode=TwoWay,Converter={StaticResource SeriesTypeToStringConverter}}"
                          ItemsSource="{Binding TypeCandidates}" />
                <TextBox Grid.Column="4" Text="{Binding Color,Mode=TwoWay}" />
                <Button Grid.Column="5" Margin="0,0,3,0" FontFamily="Segoe Fluent Icons" Content="&#xe790;" Command="{Binding ChooseColorCommand}" />
                <Button Grid.Column="6" FontFamily="Segoe Fluent Icons" Content="&#xE74D;" Click="DeleteItem" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Content="{x:Static properties:Resources.Add}" Click="AddItem" />
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Width="100" Margin="5,0,0,0" Content="{x:Static properties:Resources.OK}" Click="OkClick" />
      <Button Width="100" Margin="5,0,0,0" Content="{x:Static properties:Resources.Cancel}" Click="CancelClick" />
    </StackPanel>
  </Grid>
</UserControl>
