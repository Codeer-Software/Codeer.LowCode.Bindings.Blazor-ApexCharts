<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Version>0.26.0</Version>
    <Description>You can use Blazor-ApexCharts with Codeer.LowCode.Blazor.</Description>
    <PackageProjectUrl>https://github.com/Codeer-Software/Codeer.LowCode.Bindings.Blazor-ApexCharts</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Codeer-Software/Codeer.LowCode.Bindings.Blazor-ApexCharts</RepositoryUrl>
    <PackageTags>Blazor;LowCode;Codeer</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes>
- Property names, categories, field type names and the chart series editor are now localized (Japanese included).
    </PackageReleaseNotes>
    <PackageId>Codeer.LowCode.Bindings.Blazor-ApexCharts.Designer</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Codeer.LowCode.Blazor" Version="1.3.23" />
    <PackageReference Include="Codeer.LowCode.Blazor.Designer" Version="1.3.23" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Codeer.LowCode.Bindings.ApexCharts\Codeer.LowCode.Bindings.ApexCharts.csproj" />
  </ItemGroup>

  <!-- AI 用フィールドドキュメント。.md はこの ApexCharts.Designer プロジェクトに物理配置する
       (実装ランタイムの WASM には配信しないため)。埋め込み先もこのアセンブリ。
       FieldCatalog.AddDocAssembly の登録で `.FieldDocs.<型名>.md` 規約により解決される。 -->
  <ItemGroup>
    <None Remove="FieldDocs\**\*.md" />
    <EmbeddedResource Include="FieldDocs\**\*.md">
      <LogicalName>Codeer.LowCode.Bindings.ApexCharts.Designer.FieldDocs.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
